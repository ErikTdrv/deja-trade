# Copy to .env and fill in. Read by docker compose (interpolation) and by the api.

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=deja
POSTGRES_PASSWORD=change-me
POSTGRES_DB=deja

# API
PORT=3000

# Kafka (comma-separated brokers)
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=deja-api
